# Copy this file to .env and fill in your keys, then `pip install python-dotenv`
# and add `from dotenv import load_dotenv; load_dotenv()` at the top of app.py
# (or just export these as real environment variables before running the app).

GEMINI_API_KEY=your-gemini-api-key-here
# Leave this as the default unless you deliberately change the Gemini model.
GEMINI_MODEL_NAME=gemini-3.8-flash
# Used automatically only if the primary model temporarily returns 429/503/504.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
SECRET_KEY=change-this-to-a-random-string
# Optional: Render persistent disk mount path for SQLite and uploaded resumes.
# Keep the default for local development; use /var/data on a configured Render disk.
SKILLSYNC_DATA_DIR=data

# Firebase Web SDK (these values are safe to send to the browser). The defaults
# in app.py already point to the SkillSync Firebase project, so set these only
# when deploying with a different Firebase project.
FIREBASE_API_KEY=AIzaSyDGTw51opzCyTk3I_yZaXTrVKngHOWesB4
FIREBASE_AUTH_DOMAIN=skillsync-f84cb.firebaseapp.com
FIREBASE_PROJECT_ID=skillsync-f84cb
FIREBASE_STORAGE_BUCKET=skillsync-f84cb.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=144312228609
FIREBASE_APP_ID=1:144312228609:web:f8ddb11ad7a5c28eb31900
FIREBASE_MEASUREMENT_ID=G-W0JTGCTHJL
